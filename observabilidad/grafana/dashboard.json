{
  "uid": "andina-market",
  "title": "AndinaMarket - servicios",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Solicitudes por segundo (RPS)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (servicio) (rate(http_requests_total{handler!=\"/metrics\"}[1m]))",
          "legendFormat": "{{servicio}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latencia p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (servicio, le) (rate(http_request_duration_seconds_bucket{handler!=\"/metrics\"}[1m])))",
          "legendFormat": "{{servicio}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tasa de errores 5xx",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (servicio) (rate(http_requests_total{status=\"5xx\"}[1m])) or 0 * sum by (servicio) (rate(http_requests_total{handler!=\"/metrics\"}[1m]))) / clamp_min(sum by (servicio) (rate(http_requests_total{handler!=\"/metrics\"}[1m])), 1e-9)",
          "legendFormat": "{{servicio}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU y memoria por contenedor",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total[1m])",
          "legendFormat": "CPU {{servicio}} {{instance}}"
        },
        {
          "refId": "B",
          "expr": "process_resident_memory_bytes / 1e9",
          "legendFormat": "Memoria GB {{servicio}} {{instance}}"
        }
      ]
    }
  ]
}